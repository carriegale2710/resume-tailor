{
  "permissions": {
    "deny": ["Read(./.env)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.sh\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "job-application-agent": {
      "source": {
        "source": "github",
        "repo": "carriegale2710/job-application-agent"
      }
    }
  },
  "enabledPlugins": {
    "job-application-agent@job-application-agent": true
  },
  "ultracode": true
}
